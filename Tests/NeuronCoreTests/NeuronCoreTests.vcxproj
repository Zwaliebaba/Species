    </ProjectConfiguration>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="WorldObjectIdTests.cpp" />
    <ClCompile Include="ByteStreamTests.cpp" />
    <ClCompile Include="DArrayTests.cpp" />
    <ClCompile Include="GenericTests.cpp" />
    <ClCompile Include="LListTests.cpp" />
