  <ItemGroup>
    <ProjectReference Include="..\..\NeuronCore\NeuronCore.vcxproj">
      <Project>{1f4dcebf-ece5-4714-88e9-64a8271dc522}</Project>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{751FA0BA-2B31-0B79-BBAD-782E911726DF}</ProjectGuid>
    <RootNamespace>NeuronCoreTests</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Makes Microsoft.Cpp.UnitTest.props put CppUnitTest.h and the framework
         import library on the include and library paths, and marks the output
         DLL as a test container so vstest.console discovers it. -->
    <ProjectSubType>NativeUnitTestProject</ProjectSubType>
    <PreferredToolArchitecture Condition="'$(PreferredToolArchitecture)' == '' and '$(PROCESSOR_ARCHITECTURE)' != 'ARM64'">x64</PreferredToolArchitecture>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(SpeciesRoot)Tests\Tests.props" />
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- NeuronCore's own include path, plus NeuronCore itself. Mirroring the
           project under test is what lets a test include any header that
           project can compile against; it does not widen what a test may
           legally include, which tools/check_layering.py enforces separately. -->
      <!-- The layer under test and nothing above it. NeuronCore reaches
           upward nowhere, so a test that tries to must fail to compile;
           leaving Species and GameLogic on the path would make that
           possible again through the back door. -->
      <AdditionalIncludeDirectories>$(SpeciesRoot)NeuronCore</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
