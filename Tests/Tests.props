<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Settings shared by every <Name>Tests project, imported from each test
    .vcxproj's PropertySheets group. Same reasoning as Directory.Build.props:
    four near-identical projects, so the settings that must agree live in one
    place rather than being copy-pasted and then drifting.

    The compiler settings deliberately mirror the libraries under test —
    /std:c++20, /permissive-, MultiByte, the same three _CRT_* suppressions. A
    test binary built with a different conformance level or character set links
    a differently-translated copy of the code it is meant to be testing, and the
    mismatch surfaces as an unresolved external rather than as anything that
    names the real cause.

    Not set here, deliberately: the UnitTest include and library directories.
    Microsoft.Cpp.UnitTest.props adds both to VC_IncludePath / VC_LibraryPath_*
    off the back of <ProjectSubType>NativeUnitTestProject</ProjectSubType>. The
    path the project template writes into AdditionalIncludeDirectories
    ($(VCInstallDir)UnitTest\include) does not exist in VS 2026 — the real one is
    under VC\Auxiliary\VS — so a project relying on it only builds because the
    props file already handled it.
  -->

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_WARNINGS;_SILENCE_ALL_CXX17_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>

</Project>
